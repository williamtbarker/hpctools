#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../lib/hpctools/common.sh
source "$script_dir/../lib/hpctools/common.sh"

usage() {
  cat <<'EOF'
Usage: slurm-cancel [--confirm] JOB_ID [JOB_ID ...]

Checks that every exact job ID belongs to the current user. The default is a
dry run. Pass --confirm to invoke scancel. Bulk user or name filters are not
supported intentionally.
EOF
}

confirm="0"
while [ "$#" -gt 0 ]; do
  case "$1" in
    --confirm) confirm="1"; shift ;;
    --version) printf 'slurm-cancel %s\n' "$HPCTOOLS_VERSION"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) hpctools_die "unknown option: $1" 2 ;;
    *) break ;;
  esac
done
[ "$#" -gt 0 ] || hpctools_die "at least one job ID is required" 2
hpctools_require_command squeue
[ "$confirm" = "0" ] || hpctools_require_command scancel

current_user=${HPCTOOLS_USER:-$(id -un)}
failures=0
for job_id in "$@"; do
  if ! hpctools_is_job_id "$job_id"; then
    hpctools_error "invalid job ID: $job_id"
    failures=$((failures + 1))
    continue
  fi
  queue_format='%A|%u|%T'
  case "$job_id" in *_*) queue_format='%i|%u|%T' ;; esac
  record=$(squeue -h -j "$job_id" -o "$queue_format" 2>/dev/null | awk -F'|' -v wanted="$job_id" '$1 == wanted {print; exit}')
  if [ -z "$record" ]; then
    hpctools_error "active job not found: $job_id"
    failures=$((failures + 1))
    continue
  fi
  owner=$(printf '%s' "$record" | awk -F'|' '{print $2}')
  state=$(printf '%s' "$record" | awk -F'|' '{print $3}')
  if [ "$owner" != "$current_user" ]; then
    hpctools_error "refusing job $job_id owned by $owner (current user: $current_user)"
    failures=$((failures + 1))
    continue
  fi
  if [ "$confirm" = "1" ]; then
    if scancel "$job_id"; then
      printf 'CANCELLED\t%s\t%s\n' "$job_id" "$state"
    else
      hpctools_error "scancel failed for job $job_id"
      failures=$((failures + 1))
    fi
  else
    printf 'WOULD_CANCEL\t%s\t%s\n' "$job_id" "$state"
  fi
done

[ "$failures" -eq 0 ] || exit 1
[ "$confirm" = "1" ] || printf 'DRY_RUN\tpass --confirm to cancel these exact jobs\n'
